# Single-page app on Apache: serve index.html for any path that isn't a real file so
# React Router can handle /pricing etc. on a fresh load. The 301s below map the old
# WordPress URLs onto the new routes so nothing linked from Google, FareHarbor or the
# business profile goes dead.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Old WordPress URLs -> new routes
  RewriteCond %{QUERY_STRING} ^page_id=523$
  RewriteRule ^$ /reviews? [R=301,L]
  RewriteRule ^englewood-parasailing-adventures-florida-fl/?$ /parasailing [R=301,L]
  RewriteRule ^parasail-englewood-fl-pricing/?$ /pricing [R=301,L]
  RewriteRule ^englewood-parasailing-reviews/?$ /reviews [R=301,L]
  RewriteRule ^parasailing-pics-englewood-fl/?$ /pics [R=301,L]
  RewriteRule ^englewood-fl-parasailing-social-media/?$ /social [R=301,L]
  RewriteRule ^contact/?$ /#contact [R=301,NE,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Long cache for hashed build assets, no cache for the HTML shell.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|svg|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
