# Single-page app on Apache: serve index.html for any path that isn't a real file so
# React Router can handle /boats etc. on a fresh load. The 301s below map the old
# WordPress permalinks to the new routes.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^boat-rental-englewood-fl/?$ /boats [R=301,L]
  RewriteRule ^aloha-pontoon-rental-boats-englewood-fl/?$ /galleries/aloha [R=301,L]
  RewriteRule ^pontoon-rental-englewood-fl/?$ /galleries/sun-catcher [R=301,L]
  RewriteRule ^scout-center-console-gallery/?$ /galleries/scout [R=301,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Long cache for hashed build assets, no cache for the HTML shell.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|svg|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
